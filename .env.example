# ─── Base de datos ────────────────────────────────────────────────────────────
# Railway provee esta variable automáticamente al conectar PostgreSQL.
# Para desarrollo local podés usar un string de SQLite o PostgreSQL local.
DATABASE_URL="postgresql://user:password@localhost:5432/madedeco_fidelizacion"

# ─── Autenticación Admin ──────────────────────────────────────────────────────
# Contraseña para el panel de administrador (cambiala antes de deployar)
ADMIN_PASSWORD="madedeco2024"

# Clave secreta para los tokens JWT (usá una cadena aleatoria larga)
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# ─── URL pública de la app ────────────────────────────────────────────────────
# Railway la completa automáticamente. En desarrollo: http://localhost:3000
NEXT_PUBLIC_APP_URL="https://tu-app.up.railway.app"
